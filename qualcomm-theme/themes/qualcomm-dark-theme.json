    "gitDecoration.deletedResourceForeground": "#C43E3E",
    "gitDecoration.untrackedResourceForeground": "#4C7DFF",
    "gitDecoration.ignoredResourceForeground": "#5B6472",
    "gitDecoration.conflictingResourceForeground": "#9B6CFF",

    "breadcrumb.foreground": "#5B6472",
    "breadcrumb.focusForeground": "#D9E2F2",
    "breadcrumb.activeSelectionForeground": "#4C7DFF",

    "notificationCenterHeader.background": "#0A0F1A",
    "notifications.background": "#0A0F1A",
    "notifications.border": "#1A2232",
    "notificationsErrorIcon.foreground": "#D94B4B",
    "notificationsWarningIcon.foreground": "#B88A2D",
    "notificationsInfoIcon.foreground": "#3253DC",

    "welcomePage.progress.foreground": "#3253DC",
    "walkThrough.embeddedEditorBackground": "#0A0F1A"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5B6472", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": { "foreground": "#D9E2F2" }
    },
    {
      "name": "Keyword, Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#D94B4B" }
    },
    {
      "name": "Keyword Control",
      "scope": ["keyword.control", "keyword.control.flow"],
      "settings": { "foreground": "#D94B4B", "fontStyle": "bold" }
    },
    {
      "name": "Class, Support",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": { "foreground": "#D9E2F2" }
    },
    {
      "name": "Entity, Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#B48CFF" }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#7FAFDE" }
    },
    {
      "name": "Number, Constant, Boolean",
      "scope": ["constant.numeric", "constant.language", "constant.character", "variable.language.this"],
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#3253DC" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#3253DC" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#70C97C" }
    },
    {
      "name": "Operators, Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#697386" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.type.property-name"],
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Namespace, Module",
      "scope": ["entity.name.namespace", "storage.modifier.import", "meta.import"],
      "settings": { "foreground": "#2A8F5B" }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#3253DC", "fontStyle": "bold" }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#D9E2F2" }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#D9E2F2" }
    },
    {
      "name": "Markup Link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#4C7DFF" }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#2A8F5B" }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#C43E3E" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFFFF", "background": "#C43E3E" }
    }
  ]
}
