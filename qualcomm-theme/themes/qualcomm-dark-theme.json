    "editorOverviewRuler.border": "#060912",

    "editorError.foreground": "#D94B4B",
    "editorWarning.foreground": "#B88A2D",
    "editorInfo.foreground": "#4C7DFF",
    "editorHint.foreground": "#3253DC",

    "editorCodeLens.foreground": "#5B6472",
    "editorLightBulb.foreground": "#4C7DFF",
    "editorLightBulbAutoFix.foreground": "#2A8F5B",

    "activityBar.background": "#0A0F1A",
    "activityBar.foreground": "#D9E2F2",
    "activityBar.inactiveForeground": "#5A6472",
    "activityBar.border": "#1A2232",
    "activityBar.activeBorder": "#5571E2",
    "activityBarBadge.background": "#3253DC",
    "activityBarBadge.foreground": "#FFFFFF",

    "sideBar.background": "#010208",
    "sideBar.foreground": "#D9E2F2",
    "sideBar.border": "#1A2232",
    "sideBarTitle.foreground": "#D9E2F2",
    "sideBarSectionHeader.background": "#010208",
    "sideBarSectionHeader.foreground": "#D9E2F2",
    "sideBarSectionHeader.border": "#1A2232",

    "list.activeSelectionBackground": "#3253DC22",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#0A0F1A",
    "list.hoverBackground": "#0A0F1A",
    "list.focusBackground": "#3253DC22",
    "list.highlightForeground": "#7D93EA",
    "tree.indentGuidesStroke": "#111827",

    "statusBar.background": "#133ad5b9",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#133ad5b9",
    "statusBar.debuggingBackground": "#C43E3E",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#0F172A",
    "statusBarItem.hoverBackground": "#0A0F1A",
    "statusBarItem.remoteBackground": "#2A8F5B",
    "statusBarItem.remoteForeground": "#FFFFFF",

    "titleBar.activeBackground": "#133ad5b9",
    "titleBar.activeForeground": "#D9E2F2",
    "titleBar.inactiveBackground": "#0F172A",
    "titleBar.inactiveForeground": "#8B97A7",
    "titleBar.border": "#0F172A",

    "tab.activeBackground": "#0A0F1A",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#5571E2",
    "tab.inactiveBackground": "#0A0F1A",
    "tab.inactiveForeground": "#5B6472",
    "tab.border": "#1A2232",
    "tab.hoverBackground": "#0A0F1A",
    "editorGroupHeader.tabsBackground": "#0A0F1A",
    "editorGroupHeader.tabsBorder": "#1A2232",
    "editorGroup.border": "#1A2232",

    "panel.background": "#151f36",
    "panel.border": "#1A2232",
    "panelTitle.activeBorder": "#3253DC",
    "panelTitle.activeForeground": "#D9E2F2",
    "panelTitle.inactiveForeground": "#5B6472",

    "terminal.background": "#0A0F1A",
    "terminal.foreground": "#D9E2F2",
    "terminal.ansiBlack": "#0A0F1A",
    "terminal.ansiRed": "#D94B4B",
    "terminal.ansiGreen": "#2A8F5B",
    "terminal.ansiYellow": "#B88A2D",
    "terminal.ansiBlue": "#3253DC",
    "terminal.ansiMagenta": "#9B6CFF",
    "terminal.ansiCyan": "#4C7DFF",
    "terminal.ansiWhite": "#D9E2F2",
    "terminal.ansiBrightBlack": "#4C5563",
    "terminal.ansiBrightRed": "#E36D6D",
    "terminal.ansiBrightGreen": "#3BAA6C",
    "terminal.ansiBrightYellow": "#C79D4A",
    "terminal.ansiBrightBlue": "#4C7DFF",
    "terminal.ansiBrightMagenta": "#B48CFF",
    "terminal.ansiBrightCyan": "#6DA2FF",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "terminalCursor.foreground": "#3253DC",

    "button.background": "#3253DC",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#5571E2",
    "button.secondaryBackground": "#111827",
    "button.secondaryForeground": "#D9E2F2",
    "button.secondaryHoverBackground": "#1B2433",

    "input.background": "#0A0F1A",
    "input.foreground": "#D9E2F2",
    "input.border": "#1A2232",
    "input.placeholderForeground": "#5B6472",
    "chat.requestBorder": "#3253DC",
    "chat.requestBackground": "#0A0F1A",
    "chat.slashCommandBackground": "#0A0F1A",
    "chat.slashCommandForeground": "#D9E2F2",
    "inputOption.activeBorder": "#7D93EA",
    "inputOption.activeBackground": "#5571E214",
    "inputValidation.errorBorder": "#D94B4B",
    "inputValidation.warningBorder": "#B88A2D",
    "inputValidation.infoBorder": "#3253DC",

    "dropdown.background": "#060912",
    "dropdown.foreground": "#D9E2F2",
    "dropdown.border": "#1A2232",

    "badge.background": "#3253DC",
    "badge.foreground": "#FFFFFF",

    "progressBar.background": "#3253DC",

    "scrollbar.shadow": "#02040A66",
    "scrollbarSlider.background": "#1A223266",
    "scrollbarSlider.hoverBackground": "#1A2232AA",
    "scrollbarSlider.activeBackground": "#1A2232EE",

    "editorWidget.background": "#0A0F1A",
    "editorWidget.border": "#1A2232",
    "editorSuggestWidget.background": "#0A0F1A",
    "editorSuggestWidget.border": "#1A2232",
    "editorSuggestWidget.selectedBackground": "#3253DC22",
    "editorSuggestWidget.highlightForeground": "#4C7DFF",
    "editorHoverWidget.background": "#0A0F1A",
    "editorHoverWidget.border": "#1A2232",

    "peekView.border": "#3253DC",
    "peekViewEditor.background": "#0A0F1A",
    "peekViewResult.background": "#0A0F1A",
    "peekViewTitle.background": "#0A0F1A",

    "gitDecoration.addedResourceForeground": "#2A8F5B",
    "gitDecoration.modifiedResourceForeground": "#4C7DFF",
    "gitDecoration.deletedResourceForeground": "#C43E3E",
    "gitDecoration.untrackedResourceForeground": "#4C7DFF",
    "gitDecoration.ignoredResourceForeground": "#5B6472",
    "gitDecoration.conflictingResourceForeground": "#9B6CFF",

    "breadcrumb.foreground": "#5B6472",
    "breadcrumb.focusForeground": "#D9E2F2",
    "breadcrumb.activeSelectionForeground": "#4C7DFF",

    "notificationCenterHeader.background": "#0A0F1A",
    "notifications.background": "#0A0F1A",
    "notifications.border": "#1A2232",
    "notificationsErrorIcon.foreground": "#D94B4B",
    "notificationsWarningIcon.foreground": "#B88A2D",
    "notificationsInfoIcon.foreground": "#3253DC",

    "welcomePage.progress.foreground": "#3253DC",
    "walkThrough.embeddedEditorBackground": "#0A0F1A"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#788394", "fontStyle": "italic" }
    },
    {
      "name": "Character, Placeholder",
      "scope": ["constant.other.placeholder", "constant.character"],
      "settings": { "foreground": "#D94B4B" }
    },
    {
      "name": "Constant, Entity, Language Variable",
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language",
        "entity"
      ],
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Entity Name, Definition",
      "scope": ["entity.name", "meta.export.default", "meta.definition.variable"],
      "settings": { "foreground": "#D9A44B" }
    },
    {
      "name": "Parameter, Block, Member",
      "scope": [
        "variable.parameter.function",
        "meta.jsx.children",
        "meta.block",
        "meta.tag.attributes",
        "entity.name.constant",
        "meta.object.member",
        "meta.embedded.expression"
      ],
      "settings": { "foreground": "#D9E2F2" }
    },
    {
      "name": "Function",
      "scope": "entity.name.function",
      "settings": { "foreground": "#B48CFF" }
    },
    {
      "name": "Tag, Component",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#70C97C" }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": { "foreground": "#D94B4B" }
    },
    {
      "name": "Keyword Control",
      "scope": ["keyword.control", "keyword.control.flow"],
      "settings": { "foreground": "#D94B4B", "fontStyle": "bold" }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type"],
      "settings": { "foreground": "#D94B4B" }
    },
    {
      "name": "Import, Package",
      "scope": ["storage.modifier.package", "storage.modifier.import", "storage.type.java"],
      "settings": { "foreground": "#D9E2F2" }
    },
    {
      "name": "String",
      "scope": ["string", "string punctuation.section.embedded source"],
      "settings": { "foreground": "#7FAFDE" }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Property Name",
      "scope": "meta.property-name",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": { "foreground": "#D9A44B" }
    },
    {
      "name": "Variable Other",
      "scope": "variable.other",
      "settings": { "foreground": "#D9E2F2" }
    },
    {
      "name": "Invalid Broken",
      "scope": "invalid.broken",
      "settings": { "foreground": "#E36D6D", "fontStyle": "italic" }
    },
    {
      "name": "Invalid Deprecated",
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#E36D6D", "fontStyle": "italic" }
    },
    {
      "name": "Invalid Illegal",
      "scope": "invalid.illegal",
      "settings": { "foreground": "#E36D6D", "fontStyle": "italic" }
    },
    {
      "name": "Invalid Unimplemented",
      "scope": "invalid.unimplemented",
      "settings": { "foreground": "#E36D6D", "fontStyle": "italic" }
    },
    {
      "name": "Carriage Return",
      "scope": "carriage-return",
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#D94B4B",
        "fontStyle": "italic underline",
        "content": "^M"
      }
    },
    {
      "name": "Error Message",
      "scope": "message.error",
      "settings": { "foreground": "#E36D6D" }
    },
    {
      "name": "String Variable",
      "scope": "string variable",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Regex",
      "scope": ["source.regexp", "string.regexp"],
      "settings": { "foreground": "#7FAFDE" }
    },
    {
      "name": "Regex Character Class",
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": { "foreground": "#7FAFDE" }
    },
    {
      "name": "Regex Escape",
      "scope": "string.regexp constant.character.escape",
      "settings": { "foreground": "#70C97C", "fontStyle": "bold" }
    },
    {
      "name": "Support Constant",
      "scope": "support.constant",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Support Variable",
      "scope": "support.variable",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "JSON Key",
      "scope": "support.type.property-name.json",
      "settings": { "foreground": "#70C97C" }
    },
    {
      "name": "Module Reference",
      "scope": "meta.module-reference",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Markdown List Bullet",
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": { "foreground": "#D9A44B" }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#6DA2FF", "fontStyle": "bold" }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": { "foreground": "#70C97C" }
    },
    {
      "name": "Markup Italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#D9E2F2", "fontStyle": "italic" }
    },
    {
      "name": "Markup Bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#D9E2F2", "fontStyle": "bold" }
    },
    {
      "name": "Markup Underline",
      "scope": ["markup.underline"],
      "settings": { "fontStyle": "underline" }
    },
    {
      "name": "Markup Strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markup Inline Code",
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "#E36D6D", "background": "#3A0E0E" }
    },
    {
      "name": "Embedded Punctuation",
      "scope": ["punctuation.section.embedded"],
      "settings": { "foreground": "#D94B4B" }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "#70C97C", "background": "#06281A" }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "#D9A44B", "background": "#3A2A08" }
    },
    {
      "name": "Markup Ignored, Untracked",
      "scope": ["markup.ignored", "markup.untracked"],
      "settings": { "foreground": "#0A0F1A", "background": "#6DA2FF" }
    },
    {
      "name": "Diff Range",
      "scope": "meta.diff.range",
      "settings": { "foreground": "#B48CFF", "fontStyle": "bold" }
    },
    {
      "name": "Diff Header",
      "scope": "meta.diff.header",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Separator",
      "scope": "meta.separator",
      "settings": { "foreground": "#6DA2FF", "fontStyle": "bold" }
    },
    {
      "name": "Output",
      "scope": "meta.output",
      "settings": { "foreground": "#6DA2FF" }
    },
    {
      "name": "Bracket Highlighter",
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": { "foreground": "#788394" }
    },
    {
      "name": "Bracket Highlighter Unmatched",
      "scope": "brackethighlighter.unmatched",
      "settings": { "foreground": "#E36D6D" }
    },
    {
      "name": "Link",
      "scope": ["constant.other.reference.link", "string.other.link"],
      "settings": { "foreground": "#7FAFDE" }
    }
  ]
}
